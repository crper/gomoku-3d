{
  "name": "gomoku-3d",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D Gomoku (五子棋) game built with React, TypeScript & Three.js — 4 AI difficulties, 2D/3D views, animations, replay & SGF/JSON export.",
  "keywords": [
    "ai",
    "five-in-a-row",
    "game",
    "gomoku",
    "react",
    "renju",
    "threejs",
    "webgl"
  ],
  "homepage": "https://crper.github.io/gomoku-3d/",
  "license": "MIT",
  "author": "crper",
  "repository": {
    "type": "git",
    "url": "https://github.com/crper/gomoku-3d.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "vp config"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
