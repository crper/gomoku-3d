{
  "name": "gomoku-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A 3D Gomoku (五子棋) game built with React, TypeScript & Three.js — 4 AI difficulties, 2D/3D views, animations, replay & SGF/JSON export.",
  "keywords": [
    "gomoku",
    "renju",
    "five-in-a-row",
    "react",
    "threejs",
    "webgl",
    "game",
    "ai"
  ],
  "author": "crper",
  "license": "MIT",
  "homepage": "https://crper.github.io/gomoku-3d/",
  "repository": {
    "type": "git",
    "url": "https://github.com/crper/gomoku-3d.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild scripts/engine.test.ts scripts/replay.test.ts scripts/strength.test.ts --bundle --platform=node --format=esm --outdir=/tmp/gomoku-tests --log-level=warning && node /tmp/gomoku-tests/engine.test.mjs && node /tmp/gomoku-tests/replay.test.mjs && node /tmp/gomoku-tests/strength.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "esbuild": "^0.28.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.5",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
